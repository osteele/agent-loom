{
  "name": "agent-loom",
  "version": "0.1.0",
  "description": "Durable local messaging and coordination between coding-agent sessions",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-loom": "dist/cli.js",
    "agent-mail": "dist/cli.js"
  },
  "scripts": {
    "check": "biome check src/ examples/oh-my-pi/agent-loom-push/ && tsc --noEmit",
    "fix": "biome check --write src/ examples/oh-my-pi/agent-loom-push/",
    "test": "sh scripts/test.sh",
    "build": "./node_modules/.bin/tsc -p tsconfig.build.json",
    "prepare": "./node_modules/.bin/tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "jsonc-parser": "^3.3.1",
    "slackify-markdown": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@oh-my-pi/pi-coding-agent": "^18.1.2",
    "@types/bun": "latest",
    "fast-check": "^3.22.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "plugins/agent-loom/.claude-plugin",
    "plugins/agent-loom/skills",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
